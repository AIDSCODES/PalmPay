# PalmPay Backend Environment Variables
# Copy this file to .env and fill in the values

# Application
APP_NAME=PalmPay
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://palmpay:palmpay@localhost:5432/palmpay
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Biometric
BIOMETRIC_MATCH_THRESHOLD=0.85
BIOMETRIC_MODEL_PATH=model/palm_vein_model.pt
BIOMETRIC_MODEL_VERSION=palm_model_v1
BIOMETRIC_EMBEDDING_DIM=512
BIOMETRIC_QUALITY_THRESHOLD=0.6
BIOMETRIC_MAX_SAMPLES=5
BIOMETRIC_MIN_SAMPLES=3

# Image Processing
IMAGE_MAX_SIZE_MB=10
IMAGE_ALLOWED_FORMATS=["jpeg", "jpg", "png", "bmp"]
IMAGE_TARGET_SIZE=[224, 224]

# Security
DEVICE_AUTH_SECRET=your-super-secret-device-auth-key-change-in-production
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_API_KEY=your-admin-api-key-change-in-production

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_ATTEMPTS=5

# CORS
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Idempotency
IDEMPOTENCY_TTL_HOURS=24

# Wallet
DEFAULT_CURRENCY=INR
INITIAL_WALLET_BALANCE=0.0

# Model (Development/Placeholder)
USE_MOCK_MODEL=true